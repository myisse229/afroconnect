# Local development only. Never commit real secrets.
# Use the Internal Database URL from the PostgreSQL service in Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render supplies PORT automatically; locally the app defaults to 8080.
PORT=8080
# Generate independent random secrets with at least 32 characters each.
AFROCONNECT_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=replace-with-your-admin-login
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Benin business reporting timezone.
BUSINESS_TIMEZONE=Africa/Porto-Novo
